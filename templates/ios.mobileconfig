<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>FullScreen</key>
			<true/>
			<key>Icon</key>
			<data>{$logo}</data>
			<key>IgnoreManifestScope</key>
			<true/>
			<key>IsRemovable</key>
			<true/>
			<key>Label</key>
			<string>{$systemName}</string>
			<key>PayloadDescription</key>
			<string>主屏幕图标</string>
			<key>PayloadDisplayName</key>
			<string>{$systemName}</string>
			<key>PayloadIdentifier</key>
			<string>{$orgName}.clip</string>
			<key>PayloadType</key>
			<string>com.apple.webClip.managed</string>
			<key>PayloadUUID</key>
			<string>{$clipId}</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>Precomposed</key>
			<true/>
			<key>URL</key>
			<string>{$ios_url}</string>
		</dict>
	</array>
	<key>PayloadDescription</key>
	<string>安装后会在主屏幕添加「{$systemName}」图标，点开即可使用。不会修改系统设置，可在「设置 - 通用 - VPN 与设备管理」中删除。</string>
	<key>PayloadDisplayName</key>
	<string>{$systemName}</string>
	<key>PayloadIdentifier</key>
	<string>{$orgName}</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>{$id}</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>
