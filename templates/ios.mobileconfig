<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ConsentText</key>
	<dict>
		<key>default</key>
		<string>请点击右上角「下一步」。安装后仅在桌面增加一个入口，不会改系统设置。</string>
	</dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>FullScreen</key>
			<true/>
			<key>Icon</key>
			<data>{$logo}</data>
			<key>IgnoreManifestScope</key>
			<true/>
			<key>IsRemovable</key>
			<true/>
			<key>Label</key>
			<string>{$systemName}</string>
			<key>PayloadDescription</key>
			<string>配置 Web Clip 设置</string>
			<key>PayloadDisplayName</key>
			<string>Web Clip</string>
			<key>PayloadIdentifier</key>
			<string>{$orgName}.clip</string>
			<key>PayloadType</key>
			<string>com.apple.webClip.managed</string>
			<key>PayloadUUID</key>
			<string>{$clipId}</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>Precomposed</key>
			<true/>
			<key>URL</key>
			<string>{$ios_url}</string>
		</dict>
	</array>
	<key>PayloadDescription</key>
	<string>{$systemName} 入口：{$systemShortUrl}</string>
	<key>PayloadDisplayName</key>
	<string>{$systemName}</string>
	<key>PayloadIdentifier</key>
	<string>{$orgName}</string>
	<key>PayloadOrganization</key>
	<string>{$systemName}</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>{$id}</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>
